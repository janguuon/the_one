extends SceneTree
## Independent adversarial cases for M4 event ordering and action snapshots.
const Combat = preload("res://scripts/combat_model.gd")
var checks: int = 0
var failures: Array[String] = []


func _initialize() -> void:
	call_deferred("_run")


func _run() -> void:
	_test_dagger_first_miss_and_live_distance()
	_test_one_element_effect_per_dagger_action()
	_test_action_snapshot()
	_test_altar_end_tick_and_rearm()
	_test_oath_boundaries()
	_test_independent_streams()
	print("M4 REVIEW TESTS: %d checks, %d failures" % [checks, failures.size()])
	for message in failures:
		push_error(message)
	quit(0 if failures.is_empty() else 1)


func _check(condition: bool, message: String) -> void:
	checks += 1
	print(("PASS: " if condition else "FAIL: ") + message)
	if not condition:
		failures.append(message)


func _game(weapon: String = "W01"):
	var game = Combat.new()
	game.reset(17, "prototype", 1, weapon)
	game.boss_enabled = false
	game.player_pos = Vector2(280, 184)
	game.boss_pos = Vector2(316, 184)
	game.player_facing = Vector2.RIGHT
	return game


func _ticks(game, count: int) -> void:
	for index in range(count):
		game.step()


func _test_dagger_first_miss_and_live_distance() -> void:
	var game = _game("W03")
	game.boss_pos = Vector2(400, 184)
	game.step({"attack": true})
	_ticks(game, 6)
	_check(game.damage_dealt == 0.0 and game.stacks == 0, "A missed first dagger strike consumes neither a hit event nor a stack award")
	game.boss_pos = Vector2(316, 184)
	_ticks(game, 4)
	_check(is_equal_approx(game.damage_dealt, 7.5) and game.stacks == 1, "A connecting second dagger strike awards its damage and the action's one stack")
	_ticks(game, 14)
	_check(is_equal_approx(game.damage_dealt, 7.5) and game.stacks == 1, "Expired first dagger event does not become a delayed hit")
	game = _game("W03")
	game.oaths.assign(["O03"])
	game.boss_pos = Vector2(319, 184)
	game.step({"attack": true})
	_ticks(game, 5)
	_check(is_equal_approx(game.damage_dealt, 8.625), "Near-distance oath applies at the first dagger impact")
	game.boss_pos = Vector2(321, 184)
	_ticks(game, 5)
	_check(is_equal_approx(game.damage_dealt, 15.375) and game.stacks == 1, "Second dagger impact reads its new far distance while keeping one action stack")


func _test_one_element_effect_per_dagger_action() -> void:
	var game = _game("W03")
	game.element_id = "fire"
	game.element_charges = 2
	game.step({"attack": true})
	_ticks(game, 5)
	var first_expiry: int = game.fire_expires_tick
	var first_next: int = game.fire_next_tick
	_check(first_expiry == game.tick + 120 and first_next == game.tick + 30, "First elemental dagger impact schedules one complete burn")
	_ticks(game, 5)
	_check(game.fire_expires_tick == first_expiry and game.fire_next_tick == first_next, "Second dagger impact cannot refresh the same action's burn")
	_check(is_equal_approx(game.damage_dealt, 20.25) and game.element_charges == 1 and game.stacks == 0, "Both elemental dagger events share one charge and generate no stacks")
	_ticks(game, first_expiry - game.tick)
	_check(is_equal_approx(game.damage_dealt, 32.25) and game.fire_expires_tick == -1, "Dagger burn includes all twelve damage and expires after its final scheduled tick")
	game = _game("W03")
	game.stacks = game.stack_threshold()
	game.element_id = "frost"
	game.element_charges = 1
	game.step({"attack": true})
	_ticks(game, 5)
	var first_guard: int = game.frost_guard_until
	game.debug_damage_player(10.0)
	game.step()
	_check(is_equal_approx(game.player_hp, 92.0) and game.frost_guard_until == -1, "Frost generated by a prior dagger hit reduces the next accepted incoming hit")
	_check(first_guard > game.tick and game.stacks == 0 and game.element_charges == 0, "Resonance spends both resources once even when a later hit is interrupted")


func _test_action_snapshot() -> void:
	for weapon in ["W01", "W02", "W03", "W04", "W05"]:
		for kind in ["basic", "signature", "fire", "resonance"]:
			var game = _game(weapon)
			if kind in ["signature", "resonance"]:
				game.stacks = game.stack_threshold()
			if kind in ["fire", "resonance"]:
				game.element_id = "fire"
				game.element_charges = 2
			game.step({"attack": true})
			var snapshot: Dictionary = game.attack.duplicate(true)
			var startup: int = game.weapon_definition().startup_ticks
			# Change public resources and mutable source data after commitment.
			game.element_id = "void"
			game.element_charges = 1
			game.stacks = game.stack_threshold()
			game.data.weapons[weapon].startup_ticks = 999
			game.data.weapons[weapon].dodge_cancel_tick = 999
			_ticks(game, startup)
			_check(game.attack.kind == snapshot.kind and game.attack.element == snapshot.element and game.attack.definition.startup_ticks == startup and game.attack.definition.dodge_cancel_tick == snapshot.definition.dodge_cancel_tick, "%s %s keeps timing, cancellation, kind and element from its action snapshot" % [weapon, kind])


func _test_altar_end_tick_and_rearm() -> void:
	var game = _game()
	var altar: Dictionary = game.altars[0]
	game.player_pos = altar.pos
	game.boss_pos = Vector2(320, 184)
	var offered: String = altar.weapon
	_ticks(game, 32)
	game.debug_damage_player(1.0)
	game.step()
	_check(game.weapon_id == "W01" and altar.weapon == offered and altar.progress == 0, "Damage on the 33rd altar tick cancels the entire weapon exchange")
	game = _game()
	altar = game.altars[0]
	game.player_pos = altar.pos
	game.boss_pos = Vector2(320, 184)
	offered = altar.weapon
	_ticks(game, 32)
	game.step({"attack": true})
	_check(game.weapon_id == "W01" and altar.weapon == offered and altar.progress == 0, "An attack press on the completion tick cancels altar exchange")
	game = _game()
	altar = game.altars[0]
	game.player_pos = altar.pos
	game.boss_pos = Vector2(320, 184)
	offered = altar.weapon
	game.stacks = 5
	game.element_id = "lightning"
	game.element_charges = 3
	_ticks(game, 33)
	_check(game.weapon_id == offered and altar.weapon == "W01" and game.stacks == 0 and game.element_charges == 3, "Successful altar exchange swaps atomically and preserves held element")
	var inventory: Array = [game.weapon_id]
	for value in game.altars:
		inventory.append(value.weapon)
	inventory.sort()
	_check(inventory == ["W01", "W02", "W03", "W04", "W05"], "Altar exchange preserves exactly one instance of each weapon")
	_ticks(game, 100)
	_check(game.weapon_id == offered and not altar.armed, "Remaining still after swapping cannot exchange back")
	game.player_pos = Vector2(altar.pos) + Vector2(20, 0)
	game.step()
	_check(not altar.armed, "Exactly twenty pixels does not rearm an altar")
	game.player_pos = Vector2(altar.pos) + Vector2(20.01, 0)
	game.step()
	_check(altar.armed, "Leaving beyond twenty pixels rearms the altar")
	game.player_pos = altar.pos
	_ticks(game, 33)
	_check(game.weapon_id == "W01" and altar.weapon == offered, "Returning and waiting permits one deliberate exchange back")


func _choose(game, id: String) -> bool:
	game.oath_candidates.assign([id])
	game.selection_pending = true
	return game.choose_oath(id)


func _test_oath_boundaries() -> void:
	var game = _game()
	game.stacks = 6
	_check(_choose(game, "O02") and game.stacks == 6 and game.next_attack_kind() == "basic", "Increasing stack threshold preserves earned stacks and removes signature readiness")
	game = _game()
	game.stacks = 5
	_check(_choose(game, "O10") and game.stacks == 5 and game.next_attack_kind() == "signature", "Reducing stack threshold can immediately prepare the saved signature")
	game = _game()
	game.element_id = "fire"
	game.element_charges = 2
	_choose(game, "O08")
	_check(game.element_charges == 2 and game.element_max_charges() == 3, "Pocket oath increases future capacity without creating a charge")
	game.debug_spawn_element("fire", game.player_pos)
	game.step()
	_check(game.element_charges == 3 and game.pickups.is_empty(), "The next same-element pickup refills to the new pocket capacity")
	game = _game()
	game.player_hp = 100.0
	_choose(game, "O06")
	_check(game.player_hp == 85.0 and game.player_max_hp() == 85.0, "Reduced maximum health clamps current health immediately")
	_choose(game, "O07")
	_check(game.player_hp == 105.0 and game.player_max_hp() == 105.0, "Long breath adds twenty current and maximum health exactly once")
	game = _game()
	game.reset(17, "official")
	game.boss_enabled = false
	game.player_hp = 40.0
	game.boss_hp = 0.0
	game.step()
	_ticks(game, 90)
	_check(game.selection_pending and game.player_hp == 55.0 and game.transition_ticks_remaining == 60, "Oath selection opens after normal phase healing with a complete ready countdown remaining")
	var before: int = game.tick
	_ticks(game, 100)
	_check(game.tick == before and game.transition_ticks_remaining == 60, "Model-level oath selection freezes combat and the ready countdown")
	game.oath_candidates.assign(["O11"])
	game.choose_oath("O11")
	_check(game.player_hp == 55.0 and game.phase_heal() == 25.0, "Sanctuary does not retroactively repeat or increase the heal already granted")
	_ticks(game, 60)
	game.player_hp = 40.0
	game.boss_hp = 0.0
	game.step()
	_check(game.player_hp == 65.0, "Sanctuary adds its larger heal at the following phase end")
	for held in ["O01", "O02", "O03", "O04", "O10"]:
		game = _game()
		game.oaths.assign([held])
		var legal: Array = game.legal_oaths()
		var expected: Array = game.data.oaths[held].excludes
		var excluded := not legal.has(held)
		for id in expected:
			excluded = excluded and not legal.has(id)
		_check(excluded, "Held %s removes itself and every explicitly conflicting oath from offers" % held)


func _test_independent_streams() -> void:
	for seed_value in [1, 7, 17, 12345]:
		var first = Combat.new()
		var second = Combat.new()
		first.reset(seed_value, "official", 1, "W01")
		second.reset(seed_value, "official", 1, "W05")
		for index in range(100):
			first.cosmetic_random()
		first._begin_oath_selection()
		var a: Dictionary = first.stream_states()
		var b: Dictionary = second.stream_states()
		_check(a.boss == b.boss and a.element == b.element and a.layout == b.layout and a.oath != b.oath and a.cosmetic != b.cosmetic, "Seed %d keeps layout, boss and element streams isolated from cosmetics and oath offers" % seed_value)
		first.choose_oath("")
		first.player_pos = Vector2(320, 280)
		second.player_pos = first.player_pos
		first.debug_start_pattern("claw")
		second.debug_start_pattern("claw")
		_check(first.pattern_runner.duration == second.pattern_runner.duration and first.stream_states().boss == second.stream_states().boss, "Seed %d retains the same boss choice stream after independent menu randomness" % seed_value)
